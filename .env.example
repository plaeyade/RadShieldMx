# RadShield-MX environment example
#
# Safe default: static/offline-first frontend.
# Leave optional remote integrations disabled until the backend phase is active.

# Backend server runtime
NODE_ENV=development
PORT=3000
APP_ID=
APP_SECRET=
# Local/test example:
# DATABASE_URL=mysql://radshield:radshield@127.0.0.1:3306/radshield_mx_test
DATABASE_URL=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=

# Frontend backend bridge
VITE_ENABLE_BACKEND=false
VITE_BACKEND_URL=
# GAMMA-AI (motor científico): `gamma ecosistema servir --origen http://localhost:5173`
VITE_GAMMA_URL=

# Optional DWG conversion provider (server/backend only; never expose secrets in frontend)
DWG_CONVERSION_PROVIDER=disabled
# Recommended production path once backend is active: aps-design-automation
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BUCKET_KEY=
DWG_CONVERSION_TIMEOUT_MS=120000
DWG_MAX_UPLOAD_MB=50
# Optional alternatives for later phases
ODA_SERVICE_URL=
ODA_API_KEY=
CLOUDCONVERT_API_KEY=

# High-risk CAD workstream
# Keep disabled for RC/static deploy. Enable only in a feature branch/staging build
# after F197/F207/F229/F231-F236/F200 are green and rollback is prepared.
VITE_CANVAS_HIGH_RISK_CAD=false
VITE_CANVAS_EVENT_CONTROLLER_V2=false

# Pre-publication gates
# Use only for final public/staging smoke. Do not put secrets in frontend vars.
PUBLIC_DEPLOY_URL=
PLAYWRIGHT_TEST_BASE_URL=
RADSHIELD_ALLOW_PUBLIC_SMOKE=0
RADSHIELD_ALLOW_DB_BACKUP=0
RADSHIELD_ALLOW_DB_RESTORE_PROBE=0
# Optional when mysql.exe/mysqldump.exe are installed but not in PATH.
# Example: C:\Program Files\MySQL\MySQL Server 8.0\bin
MYSQL_BIN_DIR=

# Optional auth
VITE_KIMI_AUTH_URL=
VITE_APP_ID=

# Optional cloud sync
VITE_CLOUD_API_URL=

# Optional AI/LLM
VITE_LLM_PROVIDER=offline
VITE_OPENAI_API_KEY=
VITE_OLLAMA_BASE_URL=
VITE_LMSTUDIO_BASE_URL=

# Optional RAG/web ingestion
VITE_ENABLE_WEB_SCRAPER=false

# Optional PACS/Orthanc integration
VITE_ENABLE_PACS_REAL=false
VITE_ORTHANC_URL=

# Optional computer vision/Python runtime
VITE_OPENCV_URL=
VITE_ENABLE_OPENCV_CDN=false
VITE_PYODIDE_URL=
VITE_ENABLE_PYODIDE_CDN=false

# Optional Smart Barrier/API bridge
VITE_API_URL=

# Optional PWA cache
VITE_ENABLE_SERVICE_WORKER=false

# Optional observability
VITE_SENTRY_DSN=
VITE_APP_VERSION=release-candidate
VITE_LOG_LEVEL=warn
